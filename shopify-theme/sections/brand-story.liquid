<section class="section" style="background:rgba(201,168,124,0.08);border-top:1px solid rgba(201,168,124,0.2);"><div class="container" style="text-align:center;max-width:720px;margin:0 auto;">
  <p class="section-label" style="margin-bottom:1rem;">{{ section.settings.eyebrow | default: 'Our Story' }}</p>
  <h2 class="section-title" style="margin-bottom:1.5rem;">{{ section.settings.heading | default: 'Made in Egypt, built for the world.' }}</h2>
  <p style="color:rgba(92,61,46,0.65);line-height:1.8;font-size:1.1rem;margin-bottom:2.5rem;">{{ section.settings.body | default: 'STCH was born in Cairo from a simple belief: that the everyday objects you carry should be as thoughtfully made as the life you live.' }}</p>
  <a href="{{ section.settings.cta_url | default: '/pages/about' }}" class="btn btn-outline">{{ section.settings.cta_label | default: 'Read Our Story' }}</a>
</div></section>
{% schema %}{"name":"Brand Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Story"},{"type":"text","id":"heading","label":"Heading","default":"Made in Egypt, built for the world."},{"type":"textarea","id":"body","label":"Body"},{"type":"text","id":"cta_label","label":"Button","default":"Read Our Story"},{"type":"url","id":"cta_url","label":"URL"}],"presets":[{"name":"Brand Story"}]}{% endschema %}