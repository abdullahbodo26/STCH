<section class="config-cta"><div class="container">
  <p class="section-label" style="color:var(--sand);">{{ section.settings.eyebrow | default: 'Fully Custom' }}</p>
  <h2>{{ section.settings.heading | default: 'Design your own.' }}</h2>
  <p>{{ section.settings.body | default: 'Choose your material, finish, card capacity, engraving, and more.' }}</p>
  <a href="{{ section.settings.cta_url | default: '/pages/configure' }}" class="btn btn-sand">{{ section.settings.cta_label | default: 'Start Configuring' }}</a>
</div></section>
{% schema %}{"name":"Configurator CTA","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Fully Custom"},{"type":"text","id":"heading","label":"Heading","default":"Design your own."},{"type":"textarea","id":"body","label":"Body"},{"type":"text","id":"cta_label","label":"Button","default":"Start Configuring"},{"type":"url","id":"cta_url","label":"URL"}],"presets":[{"name":"Configurator CTA"}]}{% endschema %}